  "package_boundary": {
    "in_scope": [
      "owner-accepted definitions-bearing business meaning for session-based RBAC",
      "CyberAlchemy-v2 ontology model origin and explicit local delta",
      "typed candidate concepts and relations",
      "security and proof non-collapse rules",
      "residue for unresolved modeling choices",
      "Auth-owned L0 BusinessMeaning, a separate optional EvaluationContext and InterpretationModel path, an explicit definition-binding graph, and a FormalClaim v4 draft",
      "exact Auth Foundation owner semantic decision for the first case",
      "candidate InterpretationModel lifecycle correction that moves interpretation identity to EvaluationContext without changing FormalClaim identity",
      "deterministic definition-complete non-authoritative consumer envelope derived from the exact definition graph",
      "semantic alignment overlay from the preserved base ontology to accepted BusinessMeaning v2",
      "FormalClaim v3 as predecessor evidence rather than the current claim design",
      "explicit adapter-required boundary for the current FormalClaimSourcePayload/v2 TDE intake"
    ],
    "out_of_scope": [
      "proof obligations",
      "Lean or other proof provider execution",
      "TypeScript authorization implementation",
      "authentication protocol implementation",
      "persistence, tokens, containers, APIs, and deployment",
      "migration or mutation of projects/auth-user-management",
      "EVF evidence discharge",
      "production security or readiness"
    ]
  },
  "claim_ceiling": "This package records a preserved candidate base ontology plus a semantics-alignment overlay, owner-accepted definitions-bearing BusinessMeaning v2, a candidate InterpretationModel lifecycle correction outside FormalClaim identity, an explicit definition-binding graph, one Auth-owned L0 FormalClaim v4 draft, and a deterministic definition-complete non-authoritative consumer envelope. FormalClaim v3 remains predecessor evidence. The package proves neither FormalClaim admission, intake eligibility, an obligation, a theorem, an implementation, provider evidence, system security, resilience, release, deployment, nor production readiness.",
  "next_step": {
    "id": "AF-NEXT-009",
    "description": "Independently review the FormalClaim v4 definition closure, the ontology alignment overlay, and the InterpretationModel v4 lifecycle correction. Owner acceptance of the InterpretationModel successor and later FormalClaim admission remain separate decisions.",
    "status": "not-started"
  }
}
