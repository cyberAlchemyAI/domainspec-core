.DS_Store
.AppleDouble
.LSOverride
._*

# Node (if any tooling uses it)
node_modules/

# Pytest
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# Session data — contains operational metrics, not for public commit
pipeline/metrics/session_log.jsonl

# Client org data — NEVER commit (Law 3)
# Default-deny entire orgs/; allow only the deployment template
orgs/
!orgs/_TEMPLATE/

# Daily logs — operational, not for initial commit
daily_logs/

# Memory files — session-specific operator-memory dirs (top-level `memory/`,
# Cowork space `spaces/*/memory/`, Sovereign_Node_Handoff/memory/, etc.).
# Negate `pipeline/memory/` and `tests/memory/` because they are the
# canonical-search code directory + its test suite — shipped, imported by
# CLI modules, exercised by tests/cli.
# Narrow the negation to *.py files only so __pycache__/ stays ignored.
memory/
!pipeline/memory/
!pipeline/memory/*.py
!tests/memory/
!tests/memory/*.py

# Trigger-log JSONL is a runtime artifact, not source.
pipeline/institutional_memory/memory_consolidation_log.jsonl

# OpenClaw local config
.openclaw/

# Calibration artifacts (machine-specific)
vault_shared/machine_calibration.json

# Lock history is committed (audit trail), but session metrics are not
# pipeline/engineering/lock_history.v1.jsonl  ← DO commit this

# Jupyter
.ipynb_checkpoints/

# mypy
.mypy_cache/

# Distribution
*.tar.gz
*.whl

