{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lucifers-lights.local/schemas/invoke-refresh-closeout-receipt/1-1-0",
  "title": "LucifersLightsInvokeRefreshCloseoutReceipt",
  "description": "Acyclic owner receipt. Later Router and continuation artifacts are exact path intentions here and become digest-bound in downstream receipts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "work_pack_id",
    "task_id",
    "swu_id",
    "precloseout_source_ref",
    "target_inventory_ref",
    "applied_deltas",
    "continuation_state_path",
    "router_verification_receipt_path",
    "validation",
    "authority_effect",
    "result",
    "final_owner_write",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "llcp.invoke-refresh-closeout-receipt/v1"
    },
    "receipt_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "work_pack_id": {
      "const": "WP-LLCP-001"
    },
    "task_id": {
      "const": "TASK-LLCP-CORE"
    },
    "swu_id": {
      "$ref": "#/$defs/l0Swu"
    },
    "precloseout_source_ref": {
      "allOf": [
        {"$ref": "#/$defs/exactArtifactRef"},
        {"properties": {"path": {"pattern": "^projects/lucifers-lights/development/chapter-pipeline-evidence/SWU-LLCP-00[1-5]/attempts/attempt-[0-9]{3}/PRE-CLOSEOUT-EXECUTION-RECEIPT\\.json$"}}}
      ]
    },
    "target_inventory_ref": {
      "allOf": [
        {"$ref": "#/$defs/exactArtifactRef"},
        {"properties": {"path": {"pattern": "^projects/lucifers-lights/development/chapter-pipeline-evidence/SWU-LLCP-00[1-5]/attempts/attempt-[0-9]{3}/CLOSEOUT-TARGET-INVENTORY\\.json$"}}}
      ]
    },
    "applied_deltas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/appliedDelta"
      }
    },
    "continuation_state_path": {
      "type": "string",
      "pattern": "^projects/lucifers-lights/development/chapter-pipeline-evidence/SWU-LLCP-00[1-5]/attempts/attempt-[0-9]{3}/CONTINUATION\\.json$"
    },
    "router_verification_receipt_path": {
      "type": "string",
      "pattern": "^projects/lucifers-lights/development/chapter-pipeline-evidence/SWU-LLCP-00[1-5]/attempts/attempt-[0-9]{3}/CONTINUATION-ROUTE-RECEIPT\\.json$"
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/validationResult"
      }
    },
    "authority_effect": {
      "const": "none"
    },
    "result": {
      "enum": ["pass", "no-op"]
    },
    "final_owner_write": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "owner_capability", "completed"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^projects/lucifers-lights/development/chapter-pipeline-evidence/SWU-LLCP-00[1-5]/attempts/attempt-[0-9]{3}/INVOKE-REFRESH-RECEIPT\\.json$"
        },
        "owner_capability": {
          "const": "invoke"
        },
        "completed": {
          "const": true
        }
      }
    },
    "receipt_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"result": {"const": "pass"}},
        "required": ["result"]
      },
      "then": {
        "properties": {"applied_deltas": {"minItems": 1}}
      }
    },
    {
      "if": {
        "properties": {"result": {"const": "no-op"}},
        "required": ["result"]
      },
      "then": {
        "properties": {"applied_deltas": {"maxItems": 0}}
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "l0Swu": {
      "type": "string",
      "pattern": "^SWU-LLCP-00[1-5]$"
    },
    "exactArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "appliedDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_path", "delta_class", "before", "after"],
      "properties": {
        "target_path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "delta_class": {
          "enum": [
            "evidence_added",
            "blocker_opened",
            "blocker_resolved",
            "status_changed",
            "route_changed"
          ]
        },
        "before": {
          "$ref": "#/$defs/baseline"
        },
        "after": {
          "$ref": "#/$defs/exactArtifactRef"
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "sha256", "size_bytes"],
      "properties": {
        "state": {
          "enum": ["present", "absent"]
        },
        "sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "size_bytes": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "absent"}}},
          "then": {"properties": {"sha256": {"type": "null"}, "size_bytes": {"type": "null"}}}
        },
        {
          "if": {"properties": {"state": {"const": "present"}}},
          "then": {"properties": {"sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 0}}}
        }
      ]
    },
    "validationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validation_id", "argv", "cwd", "exit_code", "result"],
      "properties": {
        "validation_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "cwd": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "exit_code": {
          "const": 0
        },
        "result": {
          "const": "pass"
        }
      }
    }
  }
}
