{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/ide-extension/schemas/prepare-request.schema.json",
  "title": "ide-extension prepare envelope request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "agent_ref": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "context_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requested_grants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requested_skill": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "requested_skill": {}
        },
        "required": ["requested_skill"]
      },
      "then": {
        "properties": {
          "task": {}
        },
        "required": ["task"]
      }
    },
    {
      "if": {
        "properties": {
          "requested_grants": {
            "type": "array",
            "contains": { "const": "skill.invoke" }
          }
        },
        "required": ["requested_grants"]
      },
      "then": {
        "properties": {
          "requested_skill": {},
          "task": {}
        },
        "required": ["requested_skill", "task"]
      }
    }
  ]
}
