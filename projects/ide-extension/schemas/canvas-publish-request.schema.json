{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/ide-extension/schemas/canvas-publish-request.schema.json",
  "title": "ide-extension canvas publish request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "path", "title", "kind"],
  "properties": {
    "schema_version": { "const": "1" },
    "path": {
      "type": "string",
      "minLength": 6,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*%)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._ +@-]+(?:/[A-Za-z0-9._ +@-]+)*\\.html$"
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" },
    "kind": { "enum": ["presentation", "decision", "craft", "generic"] }
  }
}
