  "gates": [
    {
      "gate_id": "G1",
      "kind": "policy",
      "owner": "projects/ide-extension",
      "condition": "Original V0 surfaces and /api/canvas/publish remain unchanged.",
      "on_fail": "block"
    },
    {
      "gate_id": "G2",
      "kind": "validation",
      "owner": "dispatch-spec",
      "condition": "The design dispatch validates with zero findings.",
      "on_fail": "block"
    },
    {
      "gate_id": "G3",
      "kind": "validation",
      "owner": "invoke design and distill",
      "condition": "All six design views exist and derive plus immutable replacement is a coherent recomposable unit.",
      "on_fail": "block"
    },
    {
      "gate_id": "G4",
      "kind": "promotion_guardrail",
      "owner": "human operator",
      "condition": "Design readiness is not reported as implementation or region readiness.",
      "on_fail": "block"
    }
  ],
  "boundary_evidence": {
    "boundaries": [
      {
        "boundary_id": "B1-v0-derived-surface",
        "kind": "artifact_import",
        "from_owner": "V0 workspace surface",
        "to_owner": "Operations V1 kernel blob store",
        "applies_to_steps": [
          "S2",
          "S4"
        ],
        "contract": "Only exact selected V0 revision bytes are copied; derivation creates a new surface identity and never mutates the source.",
        "on_violation": "block"
      },
      {
        "boundary_id": "B2-operation-commit",
        "kind": "capability_handoff",
        "from_owner": "agent operation request",
        "to_owner": "projects/ide-extension local kernel",
        "applies_to_steps": [
          "S2"
        ],
        "contract": "The kernel checks operation identity and expected revision, stores complete immutable bytes, then appends result metadata.",
        "on_violation": "block"
      },
      {
        "boundary_id": "B3-design-execution",
        "kind": "capability_handoff",
        "from_owner": "invoke design",
        "to_owner": "future invoke plan and task-session",
        "applies_to_steps": [
          "S4"
        ],
        "contract": "Invoke design authors architecture only; planning and Task Session own mutation-ready decomposition and implementation.",
        "on_violation": "block"
      }
    ],
    "authority": {
      "lifecycle": "projects/ide-extension",
      "execution": "future Task Session SWUs",
      "validation": "dispatch-spec, Distill, Node tests, and Playwright",
      "evidence": "operation records, blob digests, replay tests, and browser witnesses",
      "memory": "design artifacts and kernel metadata; HTML bodies remain in owner storage",
      "promotion": "human operator through projects/ide-extension lifecycle"
    },
    "receipts": [
      {
        "receipt_id": "invoke-operations-v1-design-result",
        "producer": "invoke design",
        "required_fields": [
          "status",
          "artifacts",
          "validation",
          "blockers",
          "residue",
          "handoff_note"
        ],
        "stores": [
          "architecture bundle",
          "decision ledger",
          "glossary result",
          "layering seed",
          "next route"
        ],
        "on_missing": "block"
      }
    ],
    "state_namespaces": [
      {
        "namespace": "V0 workspace HTML",
        "owner": "project workspace and active session",
        "write_policy": "existing complete-file behavior only"
      },
      {
        "namespace": "Operations V1 immutable blobs and metadata",
        "owner": "projects/ide-extension local kernel",
        "write_policy": "content-addressed bodies plus serialized event append"
      },
      {
        "namespace": "workbench display target and iframe",
        "owner": "browser workbench",
        "write_policy": "complete revision display and separate navigation acknowledgement"
      }
    ],
    "promotion_splits": [
      {
        "source": "whole-document Operations V1 evidence",
        "target": "declared-region mutation",
        "rule": "Region semantics require a later approved design and cannot be inferred from whole-document success.",
        "on_violation": "block"
      }
    ]
  },
  "promotion_guardrails": [
    "No existing V0 API or surface identity is changed by design authoring.",
    "No HTML payload is copied into the event log.",
    "No operation commits before a complete immutable result body is durable.",
    "No navigation command is counted as a content revision.",
    "No whole-document result is promoted as declared-region readiness."
  ],
  "observability": {
    "dispatch_id_required": true,
    "trace_events": [
      "operations-v1-context-selected",
      "operations-v1-design-authored",
      "operations-v1-dispatch-validated",
