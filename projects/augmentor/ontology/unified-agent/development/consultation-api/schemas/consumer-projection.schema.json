{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "augmentor.consultation.projection@1.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "records", "structuredConflicts"],
  "properties": {
    "schemaVersion": {"const": "augmentor.consultation.projection@1.2.0"},
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label", "summary", "viewIds", "fields", "explanationSupport", "fieldProvenance", "sourceHandles", "confidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^rec-[a-f0-9]{12}$"},
          "kind": {"type": "string", "minLength": 1, "maxLength": 64},
          "label": {"type": "string", "minLength": 1, "maxLength": 160},
          "summary": {"type": "string", "minLength": 1, "maxLength": 1200},
          "viewIds": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
          "fields": {"type": "object", "additionalProperties": false, "required": ["responsibility", "boundary"], "properties": {"responsibility": {"type": "string", "minLength": 1, "maxLength": 1600}, "boundary": {"type": "string", "minLength": 1, "maxLength": 1600}}},
          "explanationSupport": {"type": "object"},
          "fieldProvenance": {"type": "object", "additionalProperties": false, "required": ["sourceHandle"], "properties": {"sourceHandle": {"type": "string", "pattern": "^src-[a-f0-9]{12}$"}}},
          "sourceHandles": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^src-[a-f0-9]{12}$"}},
          "confidence": {"type": "object"}
        }
      }
    },
    "structuredConflicts": {"type": "array"}
  }
}
