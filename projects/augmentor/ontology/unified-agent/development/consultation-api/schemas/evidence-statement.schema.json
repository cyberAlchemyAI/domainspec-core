{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "augmentor.consultation.evidence-statement@0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["statementId", "subjectId", "predicate", "object", "transformation", "sourceHandles", "freshness", "claimCeiling", "forbiddenInferences", "relevance", "confidence"],
  "properties": {
    "statementId": {"type": "string", "minLength": 1},
    "subjectId": {"type": "string", "minLength": 1},
    "predicate": {"type": "string", "minLength": 1},
    "object": {"type": ["string", "number", "boolean", "array"], "items": {"type": "string"}},
    "displayText": {"type": "string", "maxLength": 2000},
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "inputFieldRefs"],
      "properties": {
        "kind": {"enum": ["copied-field", "stored-explanation", "deterministic-comparison"]},
        "version": {"type": "string", "minLength": 1},
        "inputFieldRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "sourceHandles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^src-[a-f0-9]{12}$"}},
    "freshness": {"enum": ["current", "stale", "unknown"]},
    "claimCeiling": {"type": "string", "minLength": 1},
    "forbiddenInferences": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "relevance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithmId", "algorithmVersion", "scale", "value", "normalizedQueryDigest", "projectionDigest", "candidateScopeDigest"],
      "properties": {
        "algorithmId": {"const": "exact-token-overlap"},
        "algorithmVersion": {"const": "1.0.0"},
        "scale": {"const": "normalized-0-1"},
        "value": {"type": "number", "minimum": 0, "maximum": 1},
        "normalizedQueryDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "projectionDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "candidateScopeDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "ownerRef", "basis", "assessedAt", "sourceHandle"],
      "properties": {
        "level": {"enum": ["low", "medium", "high"]},
        "ownerRef": {"type": "string", "minLength": 1},
        "basis": {"type": "string", "minLength": 1},
        "assessedAt": {"type": "string", "minLength": 1},
        "sourceHandle": {"type": "string", "pattern": "^src-[a-f0-9]{12}$"}
      }
    }
  }
}
