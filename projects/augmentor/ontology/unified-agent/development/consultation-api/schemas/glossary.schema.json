{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "augmentor.consultation.glossary@1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "terms"],
  "properties": {
    "schemaVersion": {"const": "augmentor.consultation.glossary@1.1.0"},
    "terms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/term"}
    }
  },
  "$defs": {
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "term", "plainMeaning", "formalName", "whyItMatters", "sourceHandles", "authorityEffect", "forbiddenInferences"],
      "properties": {
        "id": {"type": "string", "pattern": "^term-[a-f0-9]{12}$"},
        "term": {"type": "string", "minLength": 1, "maxLength": 80},
        "plainMeaning": {"type": "string", "minLength": 1, "maxLength": 600},
        "formalName": {"type": ["string", "null"], "maxLength": 120},
        "whyItMatters": {"type": "string", "minLength": 1, "maxLength": 600},
        "sourceHandles": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^src-[a-f0-9]{12}$"}},
        "authorityEffect": {"const": "none"},
        "forbiddenInferences": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}}
      }
    }
  }
}
