{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "augmentor.consultation.query@0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "questionId", "operation", "query", "scope", "limits"],
  "properties": {
    "schemaVersion": {"const": "augmentor.consultation.query@0.1.0"},
    "requestId": {"type": "string", "minLength": 1, "maxLength": 128},
    "questionId": {"type": "string", "minLength": 1, "maxLength": 128},
    "operation": {"enum": ["lookup", "search", "context"]},
    "query": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "text": {"type": "string", "minLength": 1, "maxLength": 1000},
        "kind": {"type": "string", "minLength": 1, "maxLength": 64}
      },
      "anyOf": [{"required": ["id"]}, {"required": ["text"]}]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewIds"],
      "properties": {
        "viewIds": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "maxFreshnessAgeSeconds": {"type": "integer", "minimum": 0, "maximum": 31536000}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxCandidates", "maxRecords", "maxSources", "maxBytes", "maxTokens", "maxMillis"],
      "properties": {
        "maxCandidates": {"type": "integer", "minimum": 1, "maximum": 1000},
        "maxRecords": {"type": "integer", "minimum": 1, "maximum": 100},
        "maxSources": {"type": "integer", "minimum": 1, "maximum": 100},
        "maxBytes": {"type": "integer", "minimum": 256, "maximum": 1048576},
        "maxTokens": {"type": "integer", "minimum": 64, "maximum": 262144},
        "maxMillis": {"type": "integer", "minimum": 1, "maximum": 30000}
      }
    }
  }
}
