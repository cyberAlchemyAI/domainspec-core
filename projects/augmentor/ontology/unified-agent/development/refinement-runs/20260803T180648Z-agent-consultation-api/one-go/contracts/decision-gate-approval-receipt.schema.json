{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "augmentor.consultation.decision-gate-approval@0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "selected_option", "approval_status", "approval_owner", "source", "approved_at", "epoch_binding", "scope", "constraints", "authority_effect"],
  "properties": {
    "schema_version": {"const": "augmentor.consultation.decision-gate-approval@0.1.0"},
    "decision_id": {"const": "augmentor-consultation-l0-exact-epoch"},
    "selected_option": {"const": "APPROVE_EXACT_EPOCH"},
    "approval_status": {"const": "approved"},
    "approval_owner": {"const": "human-decision-gate"},
    "source": {"const": "current-user-explicit-confirmation"},
    "approved_at": {"type": "string", "format": "date-time"},
    "epoch_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epoch_id", "audit_projection_digest", "canonical_semantic_digest", "source_snapshot_digest", "finite_frontier", "run_budget", "risk_ceiling"],
      "properties": {
        "epoch_id": {"type": "string", "pattern": "^epoch-[a-f0-9]{24}$"},
        "audit_projection_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "canonical_semantic_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_snapshot_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "finite_frontier": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "run_budget": {"const": 7},
        "risk_ceiling": {"const": "bounded-write"}
      }
    },
    "scope": {"const": "candidate-local Agent Consultation API L0 only"},
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stop_on_first_blocker", "network", "deployment", "publication", "authority_change", "l1_or_later"],
      "properties": {
        "stop_on_first_blocker": {"const": true},
        "network": {"const": false},
        "deployment": {"const": false},
        "publication": {"const": false},
        "authority_change": {"const": false},
        "l1_or_later": {"const": false}
      }
    },
    "authority_effect": {"const": "none"}
  }
}
