{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "augmentor.consultation.projection-manifest@0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "compilerVersion", "allowlistDigest", "opaqueIdMapVersion", "inputSources", "recordCounts", "generatedAt", "outputDigest", "ownerApprovalRef"],
  "properties": {
    "schemaVersion": {"const": "augmentor.consultation.projection-manifest@0.1.0"},
    "compilerVersion": {"const": "fixture-compiler@0.1.0"},
    "allowlistDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "opaqueIdMapVersion": {"const": "sha256-prefix@1.0.0"},
    "inputSources": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["sourceHandle", "sha256"], "properties": {"sourceHandle": {"type": "string", "pattern": "^src-[a-f0-9]{12}$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "recordCounts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "generatedAt": {"type": "string", "minLength": 1},
    "outputDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ownerApprovalRef": {"const": "fixture-only:aug-consultation-l0"}
  }
}
