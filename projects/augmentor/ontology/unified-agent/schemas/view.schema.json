{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "augmentor.unified-agent.view@0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "view_id",
    "view_role",
    "title",
    "description",
    "owner_route",
    "source_refs",
    "node_refs",
    "relation_refs",
    "sequences",
    "allowed_readings",
    "forbidden_authority_moves",
    "residue"
  ],
  "properties": {
    "view_id": {
      "type": "string",
      "pattern": "^aug\\.view\\.[a-z0-9_]+$"
    },
    "view_role": {
      "enum": [
        "meaning",
        "system",
        "evidence",
        "bridge"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "owner_route": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "node_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "relation_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "sequences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence_id",
          "label",
          "steps"
        ],
        "properties": {
          "sequence_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "allowed_readings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "forbidden_authority_moves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "residue": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
