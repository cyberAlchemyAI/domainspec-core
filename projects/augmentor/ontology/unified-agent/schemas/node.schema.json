{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "augmentor.unified-agent.node@0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "concept_id",
    "label",
    "concept_role",
    "branches",
    "description",
    "source_refs",
    "owner_route",
    "candidate_status",
    "runtime_posture",
    "confidence",
    "challenge_contract",
    "residue",
    "forbidden_collapse"
  ],
  "properties": {
    "concept_id": {
      "type": "string",
      "pattern": "^aug\\.concept\\.[a-z0-9_]+$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "concept_role": {
      "enum": [
        "authority object",
        "evidence object",
        "workflow object",
        "projection object",
        "residue object"
      ]
    },
    "branches": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "experience",
          "runtime",
          "knowledge",
          "authority-bridge"
        ]
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "owner_route": {
      "type": "string",
      "minLength": 1
    },
    "candidate_status": {
      "enum": [
        "candidate",
        "reviewed-candidate",
        "deferred",
        "blocked",
        "projected"
      ]
    },
    "runtime_posture": {
      "enum": [
        "observed",
        "designed",
        "absent",
        "blocked",
        "deferred"
      ]
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_confidence",
        "commitment_confidence"
      ],
      "properties": {
        "evidence_confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "none"
          ]
        },
        "commitment_confidence": {
          "enum": [
            "accepted-research",
            "candidate",
            "deferred",
            "blocked"
          ]
        }
      }
    },
    "challenge_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge_response",
        "valid_challenge_modes",
        "contradiction_edges",
        "validation_edges",
        "owner_route",
        "resolution_gate",
        "blocking_questions",
        "challenge_residue_route"
      ],
      "properties": {
        "challenge_response": {
          "type": "string",
          "minLength": 1
        },
        "valid_challenge_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "evidence",
              "contradiction",
              "owner_review"
            ]
          }
        },
        "contradiction_edges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation_edges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owner_route": {
          "type": "string",
          "minLength": 1
        },
        "resolution_gate": {
          "type": "string",
          "minLength": 1
        },
        "blocking_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "challenge_residue_route": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "residue": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_collapse": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
