{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "body-war://ontology/entry.schema.json",
  "title": "Body War local ontology entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "label",
    "definition",
    "status",
    "evidence",
    "confidence",
    "next_gate",
    "contradiction_path",
    "relations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^body-war\\.ontology\\.[A-Za-z0-9._-]+$"
    },
    "kind": {
      "enum": [
        "entity",
        "operation",
        "state"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "definition": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-local"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "selector",
          "sha256"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "selector": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "basis"
      ],
      "properties": {
        "level": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "next_gate": {
      "type": "string",
      "minLength": 1
    },
    "contradiction_path": {
      "type": "string",
      "minLength": 1
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "target"
        ],
        "properties": {
          "type": {
            "enum": [
              "produces",
              "establishes"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

