# Body War / TROQAR production compose example.
# Copy to an untracked .env on the VPS and replace every placeholder.

BODY_WAR_DOMAIN=troqar.example.com
BODY_WAR_TLS_EMAIL=ops@example.com

BODY_WAR_APP_IMAGE=ghcr.io/domainspec/body-war-app
IMAGE_TAG=latest

BODY_WAR_PUBLIC_BASE_URL=https://troqar.example.com
BODY_WAR_ALLOWED_ORIGINS=https://troqar.example.com
BODY_WAR_SECURE_COOKIES=1
BODY_WAR_SESSION_SECRET=replace-with-generated-32-byte-secret

STRAVA_CLIENT_ID=replace-with-strava-client-id
STRAVA_CLIENT_SECRET=replace-with-strava-client-secret
STRAVA_REDIRECT_URI=https://troqar.example.com/api/auth/strava/callback

POSTGRES_USER=body_war
POSTGRES_PASSWORD=replace-with-generated-postgres-password
POSTGRES_DB=body_war

# Local-pilot fallback only. Production token custody requires the Postgres
# auth/profile/provider adapter from the next work-pack.
BODY_WAR_AUTH_STORE=/var/lib/body-war/auth-store.json
