{
  "name": "@domainspec/body-war-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "26.8.1"
  },
  "scripts": {
    "build": "pnpm --filter @domainspec/auth-user-management build && tsc -p tsconfig.json",
    "build:test": "pnpm --filter @domainspec/auth-user-management build && tsc -p tsconfig.test.json",
    "build:e2e": "pnpm --filter @domainspec/auth-user-management build && rm -rf .runtime/e2e-dist && tsc -p tsconfig.e2e.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "db:migrate": "pnpm run build && node dist/src/infrastructure/postgres/migrate-cli.js",
    "e2e": "pnpm run build:e2e && BODY_WAR_AUTH_BACKEND=postgres BODY_WAR_STRAVA_FAKE=1 node .runtime/e2e-dist/e2e/body-war-auth.e2e.js",
    "e2e:all": "sh scripts/e2e.sh all",
    "geometry:export": "pnpm run build && node --env-file=.env dist/src/geometry/export-strava-geometry.js",
    "geometry:reconnect": "pnpm run build && node --env-file=.env dist/src/geometry/reconnect-strava.js",
    "validate": "sh scripts/validate.sh",
    "test": "pnpm run build:test && BODY_WAR_AUTH_BACKEND=memory BODY_WAR_STRAVA_FAKE=1 node --test dist-test/tests/*.test.js",
    "test:ui": "pnpm run build && playwright test",
    "check": "pnpm run build && pnpm test",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@domainspec/auth-user-management": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "26.4.0",
    "typescript": "7.0.2"
  }
}
