{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "body-war://whole-system/system-node.schema.json",
  "title": "Body War observed system ontology node",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "concept_id", "label", "definition", "concept_role", "system_kind", "branch_roles", "source_refs", "owner_route", "observation_status", "confidence", "residue", "forbidden_collapse"],
  "properties": {
    "schema_version": { "const": "body-war-system-node/v1" },
    "concept_id": { "type": "string", "pattern": "^body-war\\.system\\.[a-z0-9_.-]+$" },
    "label": { "type": "string", "minLength": 1 },
    "definition": { "type": "string", "minLength": 1 },
    "concept_role": { "enum": ["authority object", "evidence object", "workflow object", "projection object", "residue object"] },
    "system_kind": { "enum": ["component", "interface", "module", "service", "endpoint", "schema", "table", "job", "configuration", "test", "deployment_unit", "data_store", "external_dependency", "gap"] },
    "branch_roles": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "const": "system" } },
    "source_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source_ref" } },
    "owner_route": { "type": "string", "minLength": 1 },
    "observation_status": { "enum": ["observed", "partial", "planned", "gap"] },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_confidence", "basis"],
      "properties": {
        "evidence_confidence": { "enum": ["low", "medium", "high"] },
        "basis": { "type": "string", "minLength": 1 }
      }
    },
    "residue": { "type": "array", "items": { "type": "string" } },
    "forbidden_collapse": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "selector", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "selector": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
