{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "body-war://whole-system/bridge-relation.schema.json",
  "title": "Body War business-system bridge relation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "relation_id", "predicate", "business_concept", "system_concept", "business_evidence_refs", "system_evidence_refs", "alignment_status", "note", "direction", "owner_route", "authority_effect", "forbidden_collapse"],
  "properties": {
    "schema_version": { "const": "body-war-business-system-bridge/v1" },
    "relation_id": { "type": "string", "pattern": "^body-war\\.bridge\\.[a-z0-9.-]+$" },
    "predicate": { "enum": ["realized_by", "depends_on", "constrained_by", "observed_by", "tested_by", "drifts_from", "traced_to"] },
    "business_concept": { "type": "string", "pattern": "^body-war\\.business\\.[a-z0-9.-]+$" },
    "system_concept": { "type": "string", "pattern": "^body-war\\.system\\.[a-z0-9_.-]+$" },
    "business_evidence_refs": { "type": "array", "minItems": 1, "items": { "$ref": "system-node.schema.json#/$defs/source_ref" } },
    "system_evidence_refs": { "type": "array", "minItems": 1, "items": { "$ref": "system-node.schema.json#/$defs/source_ref" } },
    "alignment_status": { "enum": ["supported", "partial", "gap", "drift"] },
    "note": { "type": "string", "minLength": 1 },
    "direction": { "const": "directed" },
    "owner_route": { "type": "string", "minLength": 1 },
    "authority_effect": { "const": "none" },
    "forbidden_collapse": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
