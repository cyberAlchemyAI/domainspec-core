  columns {"id":"id","slug":"slug","name":"name","placeLabel":"place_label","city":"city","country":"country","distanceHintMeters":"distance_hint_meters","status":"status","geometryAuthority":"geometry_authority","suggestedByPrincipalId":"suggested_by_principal_id","publicNote":"public_note","createdAt":"created_at","updatedAt":"updated_at"}
