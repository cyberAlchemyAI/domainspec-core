  meaning "ProviderTokenRecord Postgres binding with complete field mapping; SQL and IO remain adapter-owned."
  record "ProviderTokenRecord"
  adapter "PostgresStore"
  table "body_war_provider_tokens"
  schema "../app/src/infrastructure/postgres/schema.ts"
  migrations ["../app/drizzle/0000_strong_iron_man.sql","../app/drizzle/0001_lyrical_living_mummy.sql","../app/drizzle/0002_evidence_identity.sql","../app/drizzle/0003_legacy_migration.sql","../app/drizzle/0004_provider_owner.sql"]
  columns {"id":"id","accountId":"account_id","accessTokenCiphertext":"access_token_ciphertext","refreshTokenCiphertext":"refresh_token_ciphertext","expiresAt":"expires_at","createdAt":"created_at","updatedAt":"updated_at"}
