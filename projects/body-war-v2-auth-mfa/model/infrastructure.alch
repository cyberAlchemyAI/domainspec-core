  meaning "ActivityEvidenceCandidate Postgres binding with complete field mapping; SQL and IO remain adapter-owned."
  record "ActivityEvidenceCandidate"
  adapter "PostgresStore"
  table "body_war_activity_evidence_candidates"
  schema "../app/src/infrastructure/postgres/schema.ts"
  migrations ["../app/drizzle/0000_strong_iron_man.sql","../app/drizzle/0001_lyrical_living_mummy.sql","../app/drizzle/0002_evidence_identity.sql","../app/drizzle/0003_legacy_migration.sql","../app/drizzle/0004_provider_owner.sql"]
  columns {"id":"id","suggestedTrackId":"suggested_track_id","principalId":"principal_id","provider":"provider","providerActivityId":"provider_activity_id","redactedSummary":"redacted_summary","consentText":"consent_text","consentedAt":"consented_at","status":"status","createdAt":"created_at","updatedAt":"updated_at"}
