{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ontology.graph.v0.1",
  "title": "Ontology Vault Graph",
  "description": "Machine-readable ontology graph produced by the ontology-vault sigil. JSON owns field names, IDs, enums, and validation rules; markdown views are derived.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ontology_id",
    "status",
    "authority_effect",
    "source_of_truth",
    "human_view",
    "generated_at",
    "run",
    "scope",
    "sources",
    "node_roles",
    "edge_types",
    "nodes",
    "edges",
    "findings",
    "confidence_clusters",
    "indexes"
  ],
  "properties": {
    "schema_version": { "const": "ontology.graph.v0.1" },
    "schema_ref": { "type": "string" },
    "ontology_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["candidate", "reviewed", "adopted", "retired"] },
    "authority_effect": {
      "const": "none",
      "description": "An ontology graph is an evidence artifact. It never carries source authority."
    },
    "source_of_truth": { "type": "string", "minLength": 1 },
    "human_view": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "notes": { "type": "array", "items": { "type": "string" } },

    "run": {
      "type": "object",
      "additionalProperties": true,
      "required": ["sigil", "mode", "ontology_type", "type_selection_source", "branch"],
      "properties": {
        "sigil": { "const": "ontology-vault" },
        "mode": { "enum": ["map", "distill-sessions", "promote-confidence", "premise-review", "convention-update", "validate"] },
        "ontology_type": {
          "enum": ["knowledge-vault", "business-domain", "system-runtime", "business-system-bridge", "authority-governance", "architecture-property"]
        },
        "type_selection_source": { "enum": ["explicit", "profile", "inferred", "user"] },
        "selection_confidence": { "enum": ["high", "medium", "low", "exact"] },
        "ambiguity_candidates": { "type": "array", "items": { "type": "string" } },
        "user_selection_required": { "type": "boolean" },
        "project_local_type_alias": { "type": ["string", "null"] },
        "branch": { "enum": ["business", "system", "bridge", "mixed", "none"] },
        "runtime_profile": { "type": ["string", "null"] },
        "runtime_mode": { "enum": ["inline", "agents", "none"] },
        "knowledge_inflection": { "enum": ["low", "near", "high"] },
        "knowledge_inflection_rationale": { "type": "string" }
      }
    },

    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in_scope", "out_of_scope"],
      "properties": {
        "in_scope": { "type": "array", "items": { "type": "string" } },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item", "reason"],
            "properties": { "item": { "type": "string" }, "reason": { "type": "string" } }
          }
        },
        "out_of_domain": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["concern", "evidence"],
            "properties": { "concern": { "type": "string" }, "evidence": { "type": "string" } }
          }
        }
      }
    },

    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "branch", "read", "used_for"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "branch": { "enum": ["business", "system", "system-leaning", "bridge", "mixed", "unknown"] },
          "read": { "enum": ["full", "partial", "headings", "none"] },
          "used_for": { "type": "string" }
        }
      }
    },
    "sources_not_read": { "type": "array", "items": { "type": "string" } },

    "local_aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["local", "generic"],
        "properties": { "local": { "type": "string" }, "generic": { "type": "string" } }
      }
    },
    "alias_policy": { "type": "string" },

    "node_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": { "id": { "type": "string" }, "description": { "type": "string" } }
      }
    },

    "edge_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from_roles", "to_roles", "description"],
        "properties": {
          "id": { "type": "string" },
          "from_roles": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "to_roles": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "description": { "type": "string" }
        }
      }
    },

    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "role", "label", "summary", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "status": { "enum": ["defined", "referenced-undefined", "unregistered", "deprecated"] },
          "finding_ref": { "type": "string" },
          "spec_registered": { "type": "boolean" },
          "terminal": { "type": "boolean" },
          "defined": { "type": "boolean" },
          "enumerated": { "type": "boolean" },
          "closed": { "type": "boolean" },
          "formal": { "type": "string" },
          "identity": { "type": "string" },
          "fields": { "type": "array" },
          "payload": { "type": ["array", "null"] },
          "precedence": { "type": "array", "items": { "type": "string" } },
          "parameters": { "type": "array" },
          "commitment": { "enum": ["confirmed", "open", "deferred"] },
          "source": { "enum": ["domainspec", "craft-ledger"] }
        }
      }
    },

    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "type", "from", "to", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "trigger": { "type": "string" },
          "guard": { "type": "string" },
          "effect": { "type": "string" },
          "reason": { "type": "string" },
          "note": { "type": "string" },
          "finding_ref": { "type": "string" }
        }
      }
    },

    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "severity", "summary", "detail", "subjects", "evidence", "consequence", "recommended_action", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^(CON|GAP)-[0-9]{2}$" },
          "kind": { "enum": ["contradiction", "gap"] },
          "severity": { "enum": ["blocker", "flag", "note"] },
          "summary": { "type": "string" },
          "detail": { "type": "string" },
          "subjects": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "consequence": { "type": "string" },
          "recommended_action": {
            "enum": ["promote", "keep", "revise", "demote", "split", "merge", "retire", "escalate-to-decision-gate"]
          },
          "owner_route": { "type": "string" },
          "status": { "enum": ["open", "accepted", "resolved", "rejected"] },
          "note": { "type": "string" }
        }
      }
    },

    "intentional_asymmetries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "summary", "rationale", "subjects", "evidence", "status"],
        "properties": {
          "id": { "type": "string" },
          "summary": { "type": "string" },
          "rationale": { "type": "string" },
          "subjects": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "status": { "const": "intentional" }
        }
      }
    },

    "confidence_clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "members", "evidence_confidence", "commitment_confidence", "action", "rationale"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "members": { "type": "array", "items": { "type": "string" } },
          "evidence_confidence": { "enum": ["high", "medium", "low"] },
          "commitment_confidence": { "enum": ["high", "medium", "low"] },
          "action": {
            "enum": ["promote", "keep", "revise", "demote", "split", "merge", "retire", "escalate-to-decision-gate"]
          },
          "rationale": { "type": "string" },
          "findings": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "promotion_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executes_promotion"],
      "properties": {
        "executes_promotion": {
          "const": false,
          "description": "An ontology map never executes a promotion. Only a named owner route may."
        },
        "note": { "type": "string" },
        "promotions_recommended": { "type": "array", "items": { "type": "string" } },
        "demotions_recommended": { "type": "array", "items": { "type": "string" } }
      }
    },

    "does_not_establish": { "type": "array", "items": { "type": "string" } },

    "indexes": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "counts"],
      "properties": {
        "status": { "const": "generated-rebuildable-derived" },
        "counts": { "type": "object" }
      }
    }
  }
}
