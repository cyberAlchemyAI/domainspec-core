{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/projects/ontologize/schemas/optimization-chain-method.schema.json",
  "title": "Ontologize Optimization Chain Method",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chain_id",
    "chain_name",
    "vertical",
    "status",
    "run_node_refs",
    "action_fact_refs",
    "metric_refs",
    "response_window_refs",
    "analysis_method_ref",
    "association_refs",
    "desired_bi_optimization",
    "claim_label",
    "confidence_class",
    "expression_set",
    "governance_route",
    "reuse_target",
    "interpretation_limits",
    "privacy_scope",
    "contradiction_path",
    "source_basis"
  ],
  "properties": {
    "chain_id": {
      "type": "string",
      "pattern": "^optchain\\.[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$"
    },
    "chain_name": {
      "type": "string",
      "minLength": 3
    },
    "vertical": {
      "type": "string",
      "minLength": 2
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "validated",
        "approved",
        "rejected",
        "retired",
        "contradicted",
        "residue"
      ]
    },
    "run_node_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "action_fact_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "metric_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "response_window_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "analysis_method_ref": {
      "type": "string",
      "minLength": 1
    },
    "association_refs": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "desired_bi_optimization": {
      "type": "string",
      "minLength": 3
    },
    "claim_label": {
      "type": "string",
      "enum": [
        "descriptive_pattern",
        "correlation_candidate",
        "controlled_association",
        "quasi_causal_candidate",
        "decision_support_only",
        "blocked_or_residue"
      ]
    },
    "confidence_class": {
      "type": "string",
      "enum": [
        "weak",
        "moderate",
        "strong",
        "blocked"
      ]
    },
    "expression_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plain_language",
        "operator",
        "executive",
        "contract",
        "causal_careful",
        "dashboard_label",
        "ontology"
      ],
      "properties": {
        "plain_language": {
          "$ref": "#/$defs/sentence"
        },
        "operator": {
          "$ref": "#/$defs/sentence"
        },
        "executive": {
          "$ref": "#/$defs/sentence"
        },
        "contract": {
          "$ref": "#/$defs/sentence"
        },
        "causal_careful": {
          "$ref": "#/$defs/sentence"
        },
        "dashboard_label": {
          "$ref": "#/$defs/sentence"
        },
        "ontology": {
          "$ref": "#/$defs/sentence"
        }
      }
    },
    "governance_route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_record",
        "privacy_gate_required",
        "owner_decision_required",
        "knowledge_projection_required"
      ],
      "properties": {
        "candidate_record": {
          "type": "string",
          "enum": [
            "BIInsightCandidate",
            "PromotionCandidate",
            "OptimizationCandidate"
          ]
        },
        "privacy_gate_required": {
          "type": "boolean"
        },
        "owner_decision_required": {
          "type": "boolean",
          "const": true
        },
        "knowledge_projection_required": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "reuse_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surfaces",
        "allowed_use_requested",
        "scope"
      ],
      "properties": {
        "surfaces": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "allowed_use_requested": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "interpretation_limits": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "privacy_scope": {
      "type": "string",
      "enum": [
        "client_scoped",
        "workspace_safe_candidate",
        "workspace_safe_approved",
        "public_aggregate",
        "blocked_private"
      ]
    },
    "contradiction_path": {
      "type": "string",
      "minLength": 12
    },
    "source_basis": {
      "$ref": "#/$defs/non_empty_string_array"
    }
  },
  "$defs": {
    "sentence": {
      "type": "string",
      "minLength": 12
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
