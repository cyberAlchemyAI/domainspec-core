{
  "schema_version": "invoke.plan-closeout-sync-inventory.v1",
  "target": "ui-prototyping-studio-interface-workbench",
  "lifecycle_owner_route": "invoke:refresh:apply-approved",
  "baseline_binding": {
    "algorithm": "sha256",
    "existing_target": "digest exact preflight bytes",
    "future_receipt_target": "bind literal ABSENT sentinel",
    "mismatch_policy": "block synchronization and preserve the terminal source receipt as residue"
  },
  "admitted_delta_classes": [
    "evidence_added",
    "blocker_opened",
    "blocker_resolved",
    "status_changed",
    "route_changed"
  ],
  "target_contracts": {
    "WORK-PACK.md": {
      "schema": "invoke.work-pack.md.v1",
      "writable_fields": ["control.lastUpdatedAt", "control.selectedSWU", "taskStatusBoard.status", "blockers", "receiptLinks", "currentRoute"],
      "forbidden_fields": ["objective", "deliverySlices", "swuDefinitions", "claimCeilings"]
    },
    "SWU-MANIFEST.json": {
      "schema": "invoke.plan-swu-manifest.v2",
      "writable_fields": ["selected_swu", "swus[swu_id].status", "swus[swu_id].receipt_ref", "last_updated_at"],
      "forbidden_fields": ["swus[swu_id].primary_behavior", "swus[swu_id].dependencies", "swus[swu_id].serialization_after", "swus[swu_id].successor"]
    },
    "task_markdown": {
      "schema": "invoke.plan-task.md.v1",
      "writable_fields": ["status", "receipt_ref", "blockers", "synchronization"],
      "forbidden_fields": ["objective", "algorithm", "write_scope", "acceptance"]
    },
    "wave_markdown": {
      "schema": "invoke.plan-wave.md.v1",
      "writable_fields": ["status", "receipt_inventory", "blockers", "promotion_evidence"],
      "forbidden_fields": ["order", "dependency_meaning", "layer_question"]
    },
    "EXECUTION-PACK.md": {
      "schema": "invoke.execution-pack.md.v1",
      "writable_fields": ["currentGate", "receiptInventory", "blockers", "nextCandidate"],
      "forbidden_fields": ["waveOrder", "parallelism", "authorityBoundary"]
    },
    "PLAN-TRANSPORT.md": {
      "schema": "invoke.plan-transport.md.v1",
      "writable_fields": ["status", "gateState", "receiptInventory", "nextRoute"],
      "forbidden_fields": ["authoredOutputs", "claimCeilings", "ownerBoundary"]
    },
    "execution_receipt": {
      "schema": "task-session.swu-result.v1",
      "writable_fields": ["entire document on create"],
      "forbidden_fields": ["overwrite after accepted owner synchronization"]
    },
    "refresh_receipt": {
      "schema": "invoke.refresh.v1",
      "writable_fields": ["entire document on create"],
      "forbidden_fields": ["overwrite after accepted owner synchronization"]
    }
  },
  "owner_validation": [
    "terminal source receipt parses as task-session.swu-result.v1",
    "receipt swu_id equals the row swu_id",
    "SWU appears exactly once in SWU-MANIFEST.json and exactly once in its task and wave",
    "all semantic dependencies have passing synchronized receipts",
    "all serialization_after units are terminal before source mutation",
    "every acceptance receipt field in SWU-ACCEPTANCE-MATRIX.json is present and passing",
    "source validation commands named by the task passed",
    "only row targets and admitted field permissions changed"
  ],
  "successor_policy": "a successor becomes a candidate only after a passing refresh receipt and satisfied semantic plus serialization edges; it is never auto-selected",
