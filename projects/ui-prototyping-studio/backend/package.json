{
  "name": "@ui-prototyping-studio/backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "26.8.1"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "studio": "tsx src/cli/studio.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:skill": "bash ../development/operating-skill-harness/run-validation-fixtures.sh"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "26.4.0",
    "tsx": "4.20.6",
    "typescript": "7.0.2"
  }
}
