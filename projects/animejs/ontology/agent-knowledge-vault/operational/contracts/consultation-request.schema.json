{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "animejs-knowledge-consult-request/0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "operation", "query", "limits", "expected"],
  "properties": {
    "contract": {"const": "animejs-knowledge-consult-request/0.1.0"},
    "operation": {"enum": ["lookup", "search", "context", "coverage", "decision", "episode"]},
    "query": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "node_ids", "task_id", "episode_id", "version_context_id", "relation_types", "evidence_states"],
      "properties": {
        "text": {"type": "string", "maxLength": 4000},
        "node_ids": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "maxLength": 160}},
        "task_id": {"type": ["string", "null"], "maxLength": 160},
        "episode_id": {"type": ["string", "null"], "maxLength": 160},
        "version_context_id": {"type": ["string", "null"], "maxLength": 160},
        "relation_types": {"type": "array", "maxItems": 30, "uniqueItems": true, "items": {"type": "string", "maxLength": 120}},
        "evidence_states": {"type": "array", "maxItems": 10, "uniqueItems": true, "items": {"enum": ["admissible", "unconfirmed", "revoked", "unavailable", "not_applicable"]}}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false, "required": ["max_results", "max_hops", "max_response_bytes"],
      "properties": {
        "max_results": {"type": "integer", "minimum": 1, "maximum": 50},
        "max_hops": {"type": "integer", "minimum": 0, "maximum": 4},
        "max_response_bytes": {"type": "integer", "minimum": 512, "maximum": 262144}
      }
    },
    "expected": {
      "type": "object", "additionalProperties": false, "required": ["graph_digest", "projection_digest"],
      "properties": {
        "graph_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "projection_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
