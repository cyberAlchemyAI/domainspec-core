{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/animejs/agent-knowledge-vault/source-artifact/2-0-0",
  "type": "object",
  "additionalProperties": false,
  "required": ["path", "blob_sha1", "size", "kind", "structured_pointer", "evidence_status"],
  "properties": {
    "path": {"type": "string", "minLength": 1},
    "blob_sha1": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "size": {"type": "integer", "minimum": 0},
    "kind": {"enum": ["source", "type", "test", "example", "package-documentation"]},
    "structured_pointer": {"type": "string", "pattern": "^git:2c9cf8ea00329f6768c7d7902252ed977d75ce42:"},
    "evidence_status": {"enum": ["source-observed", "type-present", "test-present-not-executed", "example-source-present-not-executed"]}
  }
}
