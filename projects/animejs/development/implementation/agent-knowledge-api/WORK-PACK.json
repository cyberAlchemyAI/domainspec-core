{
  "schema_version": "animejs.agent-knowledge-api.work-pack.v1",
  "work_pack_id": "WP-AKVE-001",
  "objective": {
    "target": "projects/animejs/ontology/agent-knowledge-vault/operational",
    "outcome": "candidate-local transport-neutral consultation and append-only WorkEpisode API core",
    "coverage": [
      "neutral allowlisted vault consultation",
      "immutable WorkEpisode commands and events",
      "deterministic reduction and isolated episode projections",
      "four disjoint host capability adapters",
      "thirty approved toy scenarios"
    ],
    "non_goals": [
      "HTTP transport",
      "production persistence",
      "Augmentor or ResonantOS integration",
      "canonical vault graph mutation",
      "Lesson verification",
      "promotion, publication, deployment, or production readiness"
    ]
  },
  "owner": "animejs-vault-candidate-owner",
  "material_owner": "invoke-material-package",
  "runtime": {
    "execution_mode": "reusable-mutation",
    "admission_profile": "plan-once-selected-unit",
    "continuation_mode": "task-session-until-blocker"
  },
  "authority": {
    "class": "private",
    "effect": "none"
  },
  "publication": {
    "class": "internal",
    "release_admission": "not-granted"
  },
  "risk": {
    "maximum": "bounded-write",
    "max_task_session_requests": 10,
    "external_hosts": []
  },
  "contract_decisions": {
    "transport": "neutral core with injected host ports",
    "authorization": "four exact non-substitutable capability audiences",
    "projection": "closed allowlist and neutral records only",
    "journal": "append-only digest chain with scoped idempotency and receipt recovery",
    "reduction": "version-keyed deterministic snapshots",
    "semantic_effect": "none; task state and canonical vault remain unchanged"
  },
  "attempt_contract": {
    "id_policy": "attempt-id-equals-task-session-run-id",
    "collision_policy": "reject-existing-different-ticket",
    "success_teardown": "retain-terminal-receipt",
    "failure_teardown": "retain-block-receipt"
  },
  "receipt_contract": {
    "terminal_schema": ".agents/skills/task-session/schemas/governance-terminal-receipt.schema.json",
    "semantic_validator": "arcanum/arcana/task-session/development/validate-governance-run-contracts.py",
    "expected_result": "one terminal Task Session receipt plus one joined Invoke Refresh closeout receipt per SWU"
  },
  "closeout": {
    "owner_route": "invoke:refresh:apply-approved",
    "allowed_delta_classes": [
      "evidence_added",
      "blocker_opened",
      "blocker_resolved",
      "status_changed",
      "route_changed"
    ],
    "baseline_policy": "capture-live-present-or-absent-sha256-at-selection",
    "target_inventory": [
      "projects/animejs/development/implementation/agent-knowledge-api/WORK-PACK.json",
      "projects/animejs/development/implementation/agent-knowledge-api/HANDOFF-STATE.json",
      "the exact approved refinement task contract referenced by the selected unit"
    ],
    "required_owner_capabilities": [
      "invoke:refresh:apply-approved",
      "continuation-router:one-hop"
    ],
    "terminal_receipt_path_rule": "projects/animejs/development/implementation/agent-knowledge-api/task-sessions/{attempt_id}/TASK-SESSION-RECEIPT.json",
    "owner_receipt_path_rule": "projects/animejs/development/implementation/agent-knowledge-api/task-sessions/{attempt_id}/INVOKE-REFRESH-RECEIPT.json",
    "compensation": {
      "mode": "none",
      "rationale": "Candidate-local files have no external effect; failed bytes and their block receipt remain inspectable until repaired."
    }
  },
