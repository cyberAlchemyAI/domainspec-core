{
  "schema_version": "animejs.agent-knowledge-vault.work-pack.v1",
  "work_pack_id": "WP-AKV-001",
  "objective": {
    "target": "projects/animejs/ontology/agent-knowledge-vault",
    "outcome": "candidate-local source-bound queryable Anime.js knowledge vault",
    "coverage": [
      "all discovered official documentation routes",
      "all pinned v4.5.0 source-manifest rows"
    ],
    "non_goals": [
      "copied documentation prose",
      "promotion",
      "publication",
      "deployment",
      "production readiness"
    ]
  },
  "owner": "ontology-vault",
  "material_owner": "invoke-material-package",
  "authority": {
    "class": "private",
    "effect": "none"
  },
  "publication": {
    "class": "internal",
    "release_admission": "not-granted"
  },
  "attempt_contract": {
    "id_policy": "attempt-id-equals-task-session-run-id",
    "collision_policy": "reject-existing-different-ticket",
    "success_teardown": "retain-terminal-receipt",
    "failure_teardown": "retain-block-receipt"
  },
  "receipt_contract": {
    "terminal_schema": "arcanum/arcana/task-session/schemas/governance-terminal-receipt.schema.json",
    "semantic_validator": "arcanum/arcana/task-session/development/validate-governance-run-contracts.py",
    "expected_result": "one terminal Task Session receipt plus joined Invoke Refresh closeout receipt"
  },
  "closeout": {
    "owner_route": "invoke:refresh:apply-approved",
    "allowed_delta_classes": [
      "evidence_added",
      "blocker_opened",
      "blocker_resolved",
      "status_changed",
      "route_changed"
    ],
    "baseline_policy": "capture-live-present-or-absent-sha256-at-selection",
    "target_inventory": [
      "projects/animejs/development/implementation/agent-knowledge-vault/WORK-PACK.md",
      "projects/animejs/development/implementation/agent-knowledge-vault/WORK-PACK.json",
      "projects/animejs/development/implementation/agent-knowledge-vault/HANDOFF-STATE.json",
      "the exact owning work-pack/tasks/TASK-AKV-*.md file"
    ],
    "required_owner_capabilities": ["invoke:refresh:apply-approved", "continuation-router:one-hop"],
    "terminal_receipt_path_rule": "projects/animejs/development/implementation/agent-knowledge-vault/task-sessions/{attempt_id}/TASK-SESSION-RECEIPT.json",
    "owner_receipt_path_rule": "projects/animejs/development/implementation/agent-knowledge-vault/task-sessions/{attempt_id}/INVOKE-REFRESH-RECEIPT.json",
    "compensation": {
      "mode": "none",
      "rationale": "Candidate-local files have no external side effect; failed bytes remain evidence until repaired."
    }
  },
  "runtime": {
    "execution_mode": "reusable-mutation",
    "admission_profile": "plan-once-selected-unit"
  },
  "risk": {
    "maximum": "network",
    "max_task_session_requests": 13,
    "external_hosts": [
      "animejs.com",
      "api.github.com",
      "raw.githubusercontent.com"
    ]
  },
