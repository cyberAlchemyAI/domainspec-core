/.arcanum/work-pack-readiness/
/.task-session/
/telemetry/

# Machine-readable dispatch/research proof stays local; final prose remains
# publishable from the same research packages.
/research/**/*.json
/research/**/*.jsonl
**/research/**/*.json
**/research/**/*.jsonl
/ops/development/**/*.json
/ops/development/**/*.jsonl
**/development/research/**/*.json
**/development/research/**/*.jsonl
**/development/reviews/**/*.json
**/development/reviews/**/*.jsonl

# Source-shaped JSON remains visible even inside research/ops packages. These
# negations do not pierce the ignored run directories above.
!**/package.json
!**/package-lock.json
!**/tsconfig*.json
!**/*.schema.json
!**/*contract*.json
!**/*fixture*.json
!**/*ontology*.json
!**/*profile*.json
!**/*manifest*.json
!**/contracts/**/*.json
!**/fixtures/**/*.json
!**/ontology/**/*.json
!**/profiles/**/*.json

# Evidence directories remain local even when a receipt filename contains a
# source-shaped word such as "ontology".
**/research/**/receipts/

# Nested experiment/runtime build state.
**/.work/
**/cargo-target/
