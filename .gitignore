
__pycache__/
/arcanum-x-ray-reader-explanations/
/domainspec-lean-formalization/
# Local Python bytecode.
# Local-only nested research checkout.
*.py[cod]
*:Zone.Identifier
._*
.DS_Store
.arcanum/observability/**/*.jsonl
.arcanum/observability/reflection-state.json
.arcanum/observability/reflections/
.arcanum/runtimes/github-copilot/
business-philosopher/
domainspec-formalization/
domainspec-lean-formalization/

# Local-only session/worktree artifacts.
.claude/worktrees/
claude/current_conversations/

# Transient Playwright run output (screenshots, evidence PDFs, CLI cache).
output/playwright/
.playwright-cli/
/test-results/

# Transient Vite/Vitest cache and last-run results.
/.vite/
node_modules

# Rust build output for the architecture-conformance target.
/projects/domainspec-v2/impl/architecture-conformance/targets/rust/target/

# Central Cargo workspace build output.
/target/

# External projects checked out inside the tree (own git repos + remotes),
# intentionally not submodules — keep them out of the parent index.
/glyph/
/grain/
/projects/akashic-records/
/projects/cyberalchemy-orchestrator/
/projects/bolina/

# Local generated agent/governance execution evidence. Canonical source,
# schemas, fixtures, ontologies, profiles, and package manifests stay tracked.
**/development/task-sessions/
**/development/refinement-runs/
**/development/invoke-runs/
**/development/implementation-runs/
**/development/invoke-plan/
**/development/invoke-refresh/
**/development/goals/
**/development/**/execution-runs/
**/development/**/session-evidence/
**/development/**/goal-runs/
**/development/**/runner-run/
**/development/**/runs/
**/development/**/receipts/
**/development/**/TERMINAL-RECEIPT.json
**/development/**/EXECUTION-STATE.json
**/development/**/VALIDATION-RECEIPT.json
**/development/**/*-RECEIPT.json
**/development/**/*-REQUEST.json
**/development/**/confirmation-readiness.txt
**/development/**/*-dry-run.stderr
**/orchestration/
**/orchestrate-run/
**/research/**/orchestrate/
**/development/reviews/**/orchestrate/
/.arcanum/observability/tmp/
/.arcanum/inventory/tmp/
