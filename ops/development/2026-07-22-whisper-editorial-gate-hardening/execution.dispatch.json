      "on_fail": "block"
    },
    {
      "gate_id": "G4-promotion-boundary",
      "kind": "promotion_guardrail",
      "owner": "spellcraft and human",
      "condition": "Validation can close the revision but cannot automatically promote the candidate transport or private preset.",
      "requires_role_receipts": ["S6.spellcraft-validation"],
      "on_fail": "block"
    }
  ],
  "observability": {
    "dispatch_id_required": true,
    "trace_events": [
