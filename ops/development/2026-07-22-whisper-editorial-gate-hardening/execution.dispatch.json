      "requires_role_receipts": ["S2.spellcraft-acceptance"],
      "on_fail": "block"
    },
    {
      "gate_id": "G2-layer-evidence",
      "kind": "quality",
      "owner": "task-session under spellcraft",
      "condition": "Each selected SWU and prior layer promotion gate returns its required evidence.",
      "requires_role_receipts": ["S3.swu-and-wave-receipts"],
      "on_fail": "block"
    },
    {
      "gate_id": "G3-validation",
      "kind": "validation",
      "owner": "experiment-harness",
      "condition": "Low, medium, complex generic, private integration, packaging, and non-regression regimes have causal results.",
