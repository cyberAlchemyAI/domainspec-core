      "required_predicate": true,
      "disposition": "required",
      "selected": true,
      "ownership": {
        "accountable_owner": "vrondelli",
        "contributing_owners": ["cold-readers", "privacy-auditor"],
        "artifact_owner": "co-op-design-owner",
        "validator_owner": "invoke-design-selection-validator"
