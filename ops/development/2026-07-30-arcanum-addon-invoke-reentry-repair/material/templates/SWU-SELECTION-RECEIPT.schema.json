{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resonantos.local/arcanum-addon/swu-selection-receipt.schema.json",
  "title": "Arcanum Add-on SWU Selection Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "selection_id",
    "operator_confirmation_handle",
    "issuing_owner",
    "issued_at",
    "expires_at",
    "session_id",
    "run_id",
    "dispatch_id",
    "dispatch_sha256",
    "plan_corpus_sha256",
    "work_pack_sha256",
    "source_commit",
    "selected_swu_id",
    "selected_step_id",
    "dependency_receipts",
    "previous_closeout_sync",
    "single_use_claim_key"
  ],
  "properties": {
    "schema_version": {
      "const": "arcanum-addon.swu-selection.v1"
    },
    "status": {
      "const": "selected"
    },
    "selection_id": {
      "type": "string",
      "minLength": 1
    },
    "operator_confirmation_handle": {
      "type": "string",
      "minLength": 1
    },
    "issuing_owner": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "dispatch_id": {
      "const": "arcanum-addon-implementation-route-v3"
    },
    "dispatch_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "plan_corpus_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "work_pack_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_commit": {
      "$ref": "#/$defs/sha1"
    },
    "selected_swu_id": {
      "type": "string",
      "pattern": "^SWU-ARC-[A-Z0-9-]+$"
    },
    "selected_step_id": {
      "type": "string",
      "pattern": "^s[0-9]{2}-[a-z0-9-]+$"
    },
    "dependency_receipts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/exactReceiptRef"
      }
    },
    "previous_closeout_sync": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/exactReceiptRef"
        }
      ]
    },
    "single_use_claim_key": {
      "type": "string",
      "minLength": 16
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "exactReceiptRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^receipts/"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
