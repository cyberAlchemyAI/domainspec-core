{
  "dispatch_id": "2026-08-04-wavedb-craft-runtime-research-route",
  "intent": {
    "raw": "Research how WaveDB can provide a runtime substrate for Craft using the WaveDB README and current Craft source contracts.",
    "objective": "After explicit confirmation, execute a capability-bound research pipeline that returns an exact-bound architecture and falsifiable prototype plan without mutating Craft or treating README claims as runtime proof.",
    "target_artifact": "ops/development/2026-08-04-wavedb-craft-runtime-research/findings.md"
  },
  "mode": "mixed",
  "techniques": [
    "sequence",
    "observability_grouping"
  ],
  "subagent_strategy": {
    "status": "required",
    "trigger": "Four independent source and methodology lanes must be reconciled and attacked before a database-backed Craft runtime can be responsibly proposed.",
    "explanation": "The route separates WaveDB verification, canonical Craft mapping, lifecycle and failure analysis, and finite fixture design, then gates synthesis, adversarial review, exact-binding evidence closure, writing, and audit.",
