{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CraftWaveDBReadonlyExperimentTerminalReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "experiment",
    "workPackId",
    "result",
    "completedUnits",
    "evidenceRefs",
    "finalIdentity",
    "maximumClaim",
    "forbiddenSuccessors",
    "forbiddenEffects",
    "successor",
    "authorityEffect",
    "blockers"
  ],
  "properties": {
    "schemaVersion": { "const": "craft-wavedb-readonly-experiment-terminal.v1" },
    "experiment": { "const": "craft-wavedb-readonly-experiment" },
    "workPackId": { "const": "WP-CWE-20260806" },
    "result": { "const": "pass" },
    "completedUnits": {
      "const": ["CWE-001", "CWE-002", "CWE-003"]
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "sizeBytes"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "sizeBytes": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "finalIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptedReceiptSha256",
        "canonicalLedgerCount",
        "canonicalSourceBytes",
        "originalStoreDigest",
        "originalStoreFileCount",
        "originalStoreTotalBytes"
      ],
      "properties": {
        "acceptedReceiptSha256": { "const": "544e6bcd81ede733c2e313e18f04ca61a6b5da76e2cc21aff15ddde5d26f046f" },
        "canonicalLedgerCount": { "const": 28 },
        "canonicalSourceBytes": { "const": 814003 },
        "originalStoreDigest": { "const": "7ce467aa44b6504347eaef89f601eb04b49647613649314f09fffbe8862289b2" },
        "originalStoreFileCount": { "const": 3 },
        "originalStoreTotalBytes": { "const": 947034 }
      }
    },
    "maximumClaim": {
      "const": "A repeatable checkout-local, read-only experiment independently accessed the accepted derived Craft snapshot without changing canonical source or accepted store bytes."
    },
    "forbiddenSuccessors": {
      "type": "object",
      "additionalProperties": { "const": false },
      "minProperties": 1
    },
    "forbiddenEffects": {
      "type": "object",
      "additionalProperties": { "const": false },
      "minProperties": 1
    },
    "successor": { "type": "null" },
    "authorityEffect": { "const": "none" },
    "blockers": { "const": [] }
  }
}
