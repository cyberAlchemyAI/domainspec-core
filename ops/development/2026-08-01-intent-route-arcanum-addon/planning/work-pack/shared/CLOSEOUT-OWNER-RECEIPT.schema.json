{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/iro/closeout-owner-receipt/1-0-0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stream_id", "epoch_id", "unit_id", "owner", "joined", "terminal_receipt_sha256", "targets", "validation", "successor", "pause_gate", "status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "stream_id": {"const": "IRO-FULL-STREAM"},
    "epoch_id": {"type": "string", "minLength": 1},
    "unit_id": {"type": "string", "pattern": "^SWU-IRO-(00[1-9]|VERIFY)$"},
    "owner": {"type": "string", "minLength": 1},
    "joined": {"const": true},
    "terminal_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "targets": {"type": "array", "items": {"$ref": "#/$defs/target"}},
    "validation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "successor": {"type": "string", "minLength": 1},
    "pause_gate": {"type": ["string", "null"]},
    "status": {"enum": ["pass", "block", "no-op"]}
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "baseline", "post_sha256", "delta_class"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "baseline": {"type": "string", "pattern": "^(absent|[a-f0-9]{64})$"},
        "post_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "delta_class": {"enum": ["evidence_added", "blocker_opened", "blocker_resolved", "status_changed", "route_changed"]}
      }
    }
  }
}
