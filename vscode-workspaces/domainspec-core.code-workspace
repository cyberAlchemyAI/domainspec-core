{
  "folders": [
    {
      "name": "domainspec-core",
      "path": "..",
    },
  ],
  "settings": {
    "window.title": "DomainSpec Core - ${rootName}",
    "files.watcherExclude": {
      "**/node_modules/**": true,
      "**/.lake/**": true,
      "**/.venv/**": true,
      "**/venv/**": true,
      "**/__pycache__/**": true,
      "**/.pytest_cache/**": true,
      "**/.mypy_cache/**": true,
      "**/.ruff_cache/**": true,
      "**/.formal-tools/**": true,
      "**/.claude/worktrees/**": true,
      "**/dist/**": true,
      "**/build/**": true,
      "**/coverage/**": true,
      "**/target/**": true,
      "**/.next/**": true,
      "**/.nuxt/**": true,
      "**/.svelte-kit/**": true,
      "**/out/**": true,
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/.lake": true,
      "**/.venv": true,
      "**/venv": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.mypy_cache": true,
      "**/.ruff_cache": true,
      "**/.formal-tools": true,
      "**/.claude/worktrees": true,
      "**/dist": true,
      "**/build": true,
      "**/coverage": true,
      "**/target": true,
      "**/.next": true,
      "**/.nuxt": true,
      "**/.svelte-kit": true,
      "**/out": true,
    },
    "workbench.colorCustomizations": {
      "titleBar.activeBackground": "#7f1d1d",
      "titleBar.activeForeground": "#ffffff",
      "titleBar.inactiveBackground": "#7f1d1d99",
      "titleBar.inactiveForeground": "#ffffffcc",
      "activityBar.background": "#450a0a",
      "activityBar.foreground": "#ffffff",
      "activityBarBadge.background": "#fca5a5",
      "activityBarBadge.foreground": "#450a0a",
      "statusBar.background": "#991b1b",
      "statusBar.foreground": "#ffffff",
      "statusBar.noFolderBackground": "#991b1b",
      "statusBar.debuggingBackground": "#dc2626",
    },
  },
}
