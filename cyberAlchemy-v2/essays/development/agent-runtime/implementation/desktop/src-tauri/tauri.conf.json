{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Essays",
  "version": "0.1.0",
  "identifier": "dev.cyberalchemy.essays",
  "build": { "frontendDist": "../../../../../../workspace/runtime/dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "CyberAlchemy Workspace — Essays Runtime", "width": 1280, "height": 820 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:",
      "capabilities": ["default"]
    }
  }
}
