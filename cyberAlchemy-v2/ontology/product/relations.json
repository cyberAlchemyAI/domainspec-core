  "relation_vocabulary": [
    {
      "id": "serves",
      "label": "serves",
      "plain_language": "The source product is intended to help the target actor.",
      "forbidden_collapse": "Not evidence of adoption or measured value."
    },
    {
      "id": "applies_to",
      "label": "applies to",
      "plain_language": "The source is scoped to the target work domain.",
      "forbidden_collapse": "Not a claim that every instance of the domain is covered."
    },
    {
      "id": "addresses",
      "label": "addresses",
      "plain_language": "The source product or capability is intended to reduce the target problem.",
      "forbidden_collapse": "Not proof that the problem has been solved."
    },
    {
      "id": "claims_value_through",
      "label": "claims value through",
      "plain_language": "The source product explains its intended value using the target thesis.",
      "forbidden_collapse": "Not a promoted definition or validated market claim."
    },
    {
      "id": "delivered_as",
      "label": "delivered as",
      "plain_language": "The source product is intended to take the target delivery form.",
      "forbidden_collapse": "Not evidence that the delivery form has been released."
    },
    {
      "id": "includes_capability",
      "label": "includes capability",
      "plain_language": "The target capability contributes to the source product.",
      "forbidden_collapse": "Not exclusive ownership of the capability or its lifecycle."
    },
    {
      "id": "participates_in",
      "label": "participates in",
      "plain_language": "The source actor takes part in the target capability.",
      "forbidden_collapse": "Not automatic authority over the capability."
    },
    {
      "id": "collaborates_with",
      "label": "collaborates with",
      "plain_language": "The two actors contribute different capabilities to shared work.",
      "forbidden_collapse": "Not equal authority, merged identity, or autonomous delegation."
    },
    {
      "id": "requires",
      "label": "requires",
      "plain_language": "The target rule must hold for the source thesis or capability to remain valid.",
      "forbidden_collapse": "Not proof that the rule is implemented."
    },
    {
      "id": "produces",
      "label": "produces",
      "plain_language": "The source capability creates the target product output.",
      "forbidden_collapse": "This is a local business relation, not DomainSpec DS-D8 Operation to Event produces."
    },
    {
      "id": "enables",
      "label": "enables",
      "plain_language": "The source makes the target outcome possible or easier.",
      "forbidden_collapse": "Not proof that the outcome occurred."
    }
  ],
