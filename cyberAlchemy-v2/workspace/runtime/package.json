{
  "name": "@cyberalchemy/workspace-runtime",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {"node": "26.8.1"},
  "scripts": {
    "generate": "node scripts/build-workspace-snapshot.mjs",
    "dev": "npm run generate && vite --host 127.0.0.1",
    "build": "npm run generate && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "npm run generate && tsc --noEmit --pretty false",
    "test": "npm run generate && vitest run",
    "browser:acceptance": "node scripts/browser-acceptance.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
