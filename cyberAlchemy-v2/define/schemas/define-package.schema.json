        },
        "package_version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "block"
          ]
        },
        "material_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sources",
            "canonical_bindings",
            "definition_proposals",
            "nodes",
            "relations",
            "views",
            "residue",
            "migration_phases"
          ],
          "properties": {
            "sources": {
              "type": "integer",
              "minimum": 0
            },
            "canonical_bindings": {
              "type": "integer",
              "minimum": 0
            },
            "definition_proposals": {
              "type": "integer",
              "minimum": 0
            },
            "nodes": {
              "type": "integer",
              "minimum": 0
            },
            "relations": {
              "type": "integer",
              "minimum": 0
            },
            "views": {
              "type": "integer",
              "minimum": 0
            },
            "residue": {
              "type": "integer",
              "minimum": 0
            },
            "migration_phases": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "authority_effect": {
          "const": "none"
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        }
      }
    },
