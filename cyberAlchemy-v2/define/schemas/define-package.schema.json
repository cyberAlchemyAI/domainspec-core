{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/private/schemas/define-package/v1",
  "title": "CyberAlchemy v2 Define closed package",
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "selector"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "selector": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch_id",
        "kind",
        "ownership",
        "root_ref"
      ],
      "properties": {
        "branch_id": {
          "enum": [
            "business",
            "system",
            "bridge"
          ]
        },
        "kind": {
          "enum": [
            "business-domain",
            "system-runtime",
            "business-system-bridge"
          ]
        },
        "ownership": {
          "enum": [
            "child-package",
            "parent-package"
          ]
        },
        "root_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_ref",
        "schema_version",
        "package_id",
        "package_version",
        "title",
        "asset_posture",
        "ontology_type",
        "materialization",
        "package_root",
        "package_owner",
        "meaning_owner",
        "definition_owner",
        "runtime_owner",
        "migration_owner",
        "visibility",
        "status",
        "authority_effect",
        "current_lifecycle_state",
        "lifecycle_states",
        "branches",
        "allowed_node_roles",
        "allowed_relation_types",
        "registries",
        "schema_path",
        "validator_path",
        "material_files",
        "blocked_effects",
        "child_packages",
        "nested_package_roots",
        "collaboration_files"
      ],
      "properties": {
        "schema_ref": {
          "const": "schemas/define-package.schema.json#/$defs/profile"
        },
        "schema_version": {
          "const": "cav2-define-profile/v1"
        },
        "package_id": {
          "const": "cav2.define"
        },
        "package_version": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "asset_posture": {
          "const": "first-class-candidate"
        },
        "ontology_type": {
          "const": "business-system-bridge"
        },
        "materialization": {
          "const": "package-required"
        },
        "package_root": {
          "const": "cyberAlchemy-v2/define"
        },
        "package_owner": {
          "type": "string",
          "minLength": 1
        },
        "meaning_owner": {
          "type": "string",
          "minLength": 1
        },
        "definition_owner": {
          "type": "string",
          "minLength": 1
        },
        "runtime_owner": {
          "type": "string",
          "minLength": 1
        },
        "migration_owner": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "const": "private"
        },
        "status": {
          "const": "candidate"
        },
        "authority_effect": {
          "const": "none"
        },
        "current_lifecycle_state": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "branches": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/branch"
          }
        },
        "allowed_node_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_relation_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "registries": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sources",
            "definitions",
            "documents",
            "nodes",
            "relations",
            "views",
            "residue",
            "migration"
          ],
          "properties": {
            "sources": {
              "const": "sources.json"
            },
            "definitions": {
              "const": "definitions.json"
            },
            "documents": {
              "const": "documents.json"
            },
            "nodes": {
              "const": "nodes.json"
            },
            "relations": {
              "const": "relations.json"
            },
            "views": {
              "const": "views.json"
            },
            "residue": {
              "const": "residue.jsonl"
            },
            "migration": {
              "const": "migration/invoke.json"
            }
          }
        },
        "schema_path": {
          "const": "schemas/define-package.schema.json"
        },
        "validator_path": {
          "const": "scripts/validate.py"
        },
        "material_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blocked_effects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "child_packages": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/childPackage"
          }
        },
        "nested_package_roots": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "collaboration_files": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256",
        "size",
        "role",
        "authority_scope",
        "visibility",
        "selectors"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "authority_scope": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "enum": [
            "private",
            "public"
          ]
        },
        "selectors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sourceRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_ref",
        "schema_version",
        "sources"
      ],
      "properties": {
        "schema_ref": {
          "const": "schemas/define-package.schema.json#/$defs/sourceRegistry"
        },
        "schema_version": {
          "const": "cav2-define-sources/v1"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "canonicalBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "term",
        "source_ref",
        "use_in_package",
        "authority_effect"
      ],
      "properties": {
        "id": {
          "pattern": "^CAV2-D[0-9]+$"
        },
        "term": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "$ref": "#/$defs/sourceRef"
        },
        "use_in_package": {
          "type": "string",
          "minLength": 1
        },
        "authority_effect": {
          "const": "none"
        }
      }
    },
    "definitionProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "term",
        "aliases",
        "status",
        "canonical_target",
        "normative_voice",
        "formal_voice",
        "plain_language_voice",
        "domain_context_voice",
        "boundary",
        "owner_route",
        "source_refs",
        "authority_effect"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "term": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "status": {
          "const": "candidate"
        },
        "canonical_target": {
          "const": "unassigned"
        },
        "normative_voice": {
          "type": "string",
          "minLength": 1
        },
        "formal_voice": {
          "type": "string",
          "minLength": 1
        },
        "plain_language_voice": {
          "type": "string",
          "minLength": 1
        },
        "domain_context_voice": {
          "type": "string",
          "minLength": 1
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        },
        "owner_route": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "authority_effect": {
          "const": "none"
        }
      }
    },
    "definitionRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_ref",
        "schema_version",
        "canonical_source",
        "canonical_bindings",
        "proposals"
      ],
      "properties": {
        "schema_ref": {
          "const": "schemas/define-package.schema.json#/$defs/definitionRegistry"
        },
        "schema_version": {
          "const": "cav2-define-definitions/v1"
        },
        "canonical_source": {
          "const": "cyberAlchemy-v2/authority/definitions/DEFINITIONS.md"
        },
        "canonical_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/canonicalBinding"
          }
        },
        "proposals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/definitionProposal"
          }
        }
      }
    },
    "documentAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "owner_route",
        "authority_effect"
      ],
      "properties": {
        "status": {
          "const": "blocked"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "owner_route": {
          "type": "string",
          "minLength": 1
        },
        "authority_effect": {
          "const": "none"
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "title",
        "role",
        "intended_canonical_kind",
        "durability",
        "status",
        "canonical_status",
        "authority_state",
        "owner_route",
        "projection_refs",
        "required_headings",
        "authority_effect",
        "claim_ceiling"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^docs/[A-Z-]+\\.md$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "capability-meaning",
            "lifecycle-model",
            "authority-boundary",
            "output-contract",
            "interaction-model"
          ]
        },
        "intended_canonical_kind": {
          "const": "spec"
        },
        "durability": {
          "const": "perennial"
        },
        "status": {
          "const": "candidate"
        },
        "canonical_status": {
          "const": "not-admitted"
        },
        "authority_state": {
          "const": "none"
        },
        "owner_route": {
          "type": "string",
          "minLength": 1
        },
        "projection_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_headings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^## "
          }
        },
        "authority_effect": {
          "const": "none"
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "documentRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_ref",
        "schema_version",
        "status",
        "durability",
        "canonical_admission",
        "source_order",
        "documents",
        "authority_effect",
        "claim_ceiling"
      ],
      "properties": {
        "schema_ref": {
          "const": "schemas/define-package.schema.json#/$defs/documentRegistry"
        },
        "schema_version": {
          "const": "cav2-define-documents/v1"
        },
        "status": {
          "const": "candidate"
        },
        "durability": {
          "const": "perennial"
        },
        "canonical_admission": {
          "$ref": "#/$defs/documentAdmission"
        },
        "source_order": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "documents": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/document"
          }
        },
        "authority_effect": {
          "const": "none"
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "branch",
        "role",
        "plain_language",
        "claim",
        "status",
        "implementation_status",
        "source_refs",
        "owner_route",
        "evidence_confidence",
        "commitment_confidence",
        "authority_effect",
        "forbidden_collapse"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "enum": [
            "business",
            "system",
            "bridge"
          ]
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "plain_language": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "candidate"
        },
        "implementation_status": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "owner_route": {
          "type": "string",
          "minLength": 1
        },
        "evidence_confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "commitment_confidence": {
          "enum": [
            "conditional",
            "committed"
          ]
        },
        "authority_effect": {
          "const": "none"
        },
        "forbidden_collapse": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nodeRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_ref",
        "schema_version",
        "nodes"
      ],
      "properties": {
        "schema_ref": {
          "const": "schemas/define-package.schema.json#/$defs/nodeRegistry"
        },
        "schema_version": {
          "const": "cav2-define-nodes/v1"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "source",
        "target",
        "branch",
        "direction",
        "source_refs",
        "alignment_state",
        "authority_effect",
        "forbidden_collapse"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "enum": [
            "business",
            "system",
            "bridge"
          ]
        },
        "direction": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "alignment_state": {
          "type": "string",
          "minLength": 1
        },
        "authority_effect": {
          "const": "none"
        },
        "forbidden_collapse": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relationRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_ref",
        "schema_version",
        "relations"
      ],
      "properties": {
        "schema_ref": {
          "const": "schemas/define-package.schema.json#/$defs/relationRegistry"
        },
        "schema_version": {
          "const": "cav2-define-relations/v1"
        },
        "relations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/relation"
          }
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "branch",
        "purpose",
        "node_ids",
        "relation_ids",
        "claim_ceiling"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "enum": [
            "business",
            "system",
            "bridge"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "node_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "relation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "viewRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_ref",
        "schema_version",
        "views"
      ],
      "properties": {
        "schema_ref": {
          "const": "schemas/define-package.schema.json#/$defs/viewRegistry"
        },
        "schema_version": {
          "const": "cav2-define-views/v1"
        },
        "views": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/view"
          }
        }
      }
    },
    "residueEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "kind",
        "statement",
        "owner_route",
        "next_gate",
        "subject_refs",
        "source_refs",
        "authority_effect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "open",
            "blocked"
          ]
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "owner_route": {
          "type": "string",
          "minLength": 1
        },
        "next_gate": {
          "type": "string",
          "minLength": 1
        },
        "subject_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "authority_effect": {
          "const": "none"
        }
      }
    },
    "migrationSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "owner_route",
        "visibility"
      ],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "owner_route": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "enum": [
            "public",
            "private"
          ]
        },
        "current_role": {
          "type": "string",
          "minLength": 1
        },
        "target_role": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "current_role"
          ],
          "not": {
            "required": [
              "target_role"
            ]
          }
        },
        {
          "required": [
            "target_role"
          ],
          "not": {
            "required": [
              "current_role"
            ]
          }
        }
      ]
    },
    "migrationPhase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "owner_route",
        "effect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "complete",
            "pending"
          ]
        },
        "owner_route": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "type": "string",
          "minLength": 1
        }
      }
