        "owner_route",
        "authority_effect",
        "claim_ceiling"
      ],
      "properties": {
        "schema_ref": {
          "const": "../schemas/define-package.schema.json#/$defs/migration"
        },
        "schema_version": {
          "const": "cav2-define-invoke-migration/v1"
        },
        "migration_id": {
          "const": "MIG-CAV2-DEFINE-FROM-INVOKE-V1"
        },
        "source_surface": {
