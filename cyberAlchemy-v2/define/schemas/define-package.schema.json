          "minLength": 1
        },
        "profile_path": {
          "type": "string",
          "minLength": 1
        },
        "validator_path": {
          "type": "string",
          "minLength": 1
        },
        "receipt_glob": {
          "type": "string",
          "minLength": 1
        },
        "owner_route": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "const": "private"
        },
        "authority_effect": {
          "const": "none"
        }
      }
