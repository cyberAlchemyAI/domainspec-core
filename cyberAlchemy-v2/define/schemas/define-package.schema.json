        },
        "required_gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "compatibility_options": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "owner_route": {
          "type": "string",
          "minLength": 1
        },
        "authority_effect": {
          "const": "none"
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        }
      }
