    "validationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "package_id",
        "package_version",
        "status",
        "material_digest",
        "checks",
        "counts",
        "authority_effect",
        "claim_ceiling"
      ],
      "properties": {
